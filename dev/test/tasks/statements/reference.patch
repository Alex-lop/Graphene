diff --git a/tests/test_currency.py b/tests/test_currency.py
new file mode 100644
index 0000000..118719a
--- /dev/null
+++ b/tests/test_currency.py
@@ -0,0 +1,158 @@
+"""Multi-currency: a currency on every posting, balances and statement sections per currency, the
+v1 export and the monthly file as they were for US dollars."""
+
+import json
+import sqlite3
+import tempfile
+import unittest
+from decimal import Decimal
+from pathlib import Path
+
+from api.export import dumps, export_v1
+from api.statement import money, render
+from core import balances, db, interest, ledger
+from core.money import currency
+from tests.support import database
+
+MIXED = """account,posted_on,amount,memo,currency
+ACC-1001,2026-09-01,100,usd in,USD
+ACC-1001,2026-09-02,200.125,eur in,EUR
+ACC-1001,2026-09-03,-0.005,eur fee,eur
+ACC-1001,2026-09-04,300,no currency,
+"""
+
+
+class Migration(unittest.TestCase):
+    def test_postings_made_before_it_are_usd(self):
+        path = str(Path(tempfile.mkdtemp()) / "old.db")
+        conn = sqlite3.connect(path)
+        self.addCleanup(conn.close)
+        for _, _, file in db.migrations()[:4]:
+            conn.executescript(file.read_text())
+        conn.execute("INSERT INTO accounts VALUES (1, 'ACC-1', 'x', '2026-01-01')")
+        conn.execute("INSERT INTO postings (account_id, posted_on, amount) VALUES (1, '2026-01-02', '5')")
+        conn.commit()
+        for _, _, file in db.migrations()[4:]:
+            conn.executescript(file.read_text())
+        self.assertEqual(conn.execute("SELECT currency FROM postings").fetchall(), [("USD",)])
+
+    def test_the_numbers_are_contiguous(self):
+        self.assertEqual([n for n, _, _ in db.migrations()], list(range(1, len(db.migrations()) + 1)))
+
+
+class PerCurrency(unittest.TestCase):
+    def setUp(self):
+        self.conn, _ = database(MIXED)
+        self.addCleanup(self.conn.close)
+
+    def test_a_currency_is_three_letters_and_nothing_is_usd(self):
+        self.assertEqual((currency(" eur "), currency("")), ("EUR", "USD"))
+        with self.assertRaises(ValueError):
+            currency("EURO")
+
+    def test_balances_are_never_added_across_currencies(self):
+        self.assertEqual(
+            balances.balances(self.conn, "ACC-1001"), {"EUR": Decimal("200.12"), "USD": Decimal("400")}
+        )
+
+    def test_one_statement_section_per_currency(self):
+        text = render(self.conn, "ACC-1001", "2026-09")
+        self.assertEqual([ln for ln in text.splitlines() if ln in ("EUR", "USD")], ["EUR", "USD"])
+        self.assertIn("Closing balance                                           200.12", text)
+        self.assertIn("Closing balance                                           400.00", text)
+
+    def test_v1_is_usd_and_keeps_its_shape(self):
+        doc = json.loads(dumps(export_v1(self.conn, "ACC-1001", "2026-09")))
+        self.assertEqual(doc["closing"], "400")
+        self.assertEqual([p["memo"] for p in doc["postings"]], ["usd in", "no currency"])
+        self.assertEqual(list(doc["postings"][0]), ["id", "account", "posted_on", "amount", "memo"])
+
+    def test_interest_is_per_currency(self):
+        posted = interest.accrue(self.conn, "2026-10", "0.0365")
+        self.assertEqual([(a, c) for a, _, c in posted], [("ACC-1001", "EUR"), ("ACC-1001", "USD")])
+
+
+class HalfEven(unittest.TestCase):
+    def test_halves_go_to_the_even_cent_where_a_float_would_not(self):
+        cases = {"0.125": "0.12", "0.135": "0.14", "2.675": "2.68", "2.665": "2.66", "-0.005": "0.00",
+                 "1234567.885": "1,234,567.88", "-2500.675": "-2,500.68"}  # fmt: skip
+        self.assertEqual({k: money(Decimal(k)) for k in cases}, cases)
+
+    def test_the_monthly_file_still_rounds_half_up(self):
+        conn, _ = database("account,posted_on,amount,memo\nACC-1001,2026-09-01,0.125,x\n")
+        self.addCleanup(conn.close)
+        from legacy.monthly import lines
+
+        self.assertEqual(lines(conn, "2026-09")[1], "ACC-1001,2026-09,0.00,0.00,0.13,0.13")
+
+
+# Ada owes 30 dollars from August and holds 500 euros. Grace is overdrawn in euros only.
+OWED = """account,posted_on,amount,memo,currency
+ACC-1001,2026-08-01,-30,card,USD
+ACC-1001,2026-08-02,500,deposit,EUR
+ACC-1002,2026-09-01,50,deposit,USD
+ACC-1002,2026-09-11,-365,rent,EUR
+"""
+
+
+class EveryReportPerCurrency(unittest.TestCase):
+    def setUp(self):
+        self.conn, _ = database(OWED)
+        self.addCleanup(self.conn.close)
+
+    def test_a_euro_never_pays_a_dollar_charge(self):
+        from core import aging
+
+        self.assertEqual([i.owed for i in aging.open_items(self.conn, "ACC-1001", "2026-09-30", "USD")], [30])
+        rows = [(r["account"], r["currency"], r["total"]) for r in aging.report(self.conn, "2026-09-30")]
+        self.assertEqual(rows, [("ACC-1001", "USD", 30), ("ACC-1002", "EUR", 365), ("TOTAL", "EUR", 365),
+                                ("TOTAL", "USD", 30)])  # fmt: skip
+
+    def test_fees_are_charged_in_the_currency_that_owes_them(self):
+        from core import fees
+
+        charged = [(n, memo, code) for n, memo, _, code in fees.charge(self.conn, "2026-09")]
+        self.assertEqual(
+            charged,
+            [("ACC-1001", "overdraft charge", "USD"), ("ACC-1001", "late fee", "USD"),
+             ("ACC-1002", "overdraft charge", "EUR")],
+        )  # fmt: skip
+        self.assertEqual(balances.balances(self.conn, "ACC-1002")["USD"], Decimal("50"))
+
+    def test_the_dunning_letter_is_for_the_dollars_whatever_the_euros(self):
+        from api import dunning
+
+        text = dunning.letters(self.conn, "2026-09")[0][2]
+        self.assertIn("USD\n  2026-08-01  card", text)
+        self.assertNotIn("EUR", text)
+
+    def test_interest_in_two_currencies_is_not_interest_twice(self):
+        from core import audit
+
+        conn, _ = database(MIXED)
+        self.addCleanup(conn.close)
+        interest.accrue(conn, "2026-09", "0.0365")
+        self.assertEqual([c for c, _, _ in audit.run(conn, "2026-09") if c == "interest"], [])
+
+    def test_a_euro_line_never_matches_a_dollar_posting(self):
+        from core import reconcile
+
+        path = Path(tempfile.mkdtemp()) / "s.csv"
+        path.write_text("account,settled_on,amount,reference,currency\nACC-1002,2026-09-12,-365,PX-1,USD\n")
+        rec = reconcile.reconcile(self.conn, path, "2026-09")
+        self.assertEqual((rec.matched, rec.currencies), ([], ["EUR", "USD"]))
+        self.assertEqual((rec.difference("USD"), rec.difference("EUR")), (Decimal("-415"), Decimal("365")))
+
+    def test_the_month_end_and_the_csv_have_a_part_for_each_currency(self):
+        from api import csvexport
+        from core import summary
+
+        got = summary.month_end(self.conn, "2026-09")
+        self.assertEqual({code: f["closing"] for code, f in got.items()}, {"EUR": Decimal("135"),
+                         "USD": Decimal("20")})  # fmt: skip
+        rows = csvexport.render(self.conn, "ACC-1001", "2026-09").splitlines()
+        self.assertEqual([r.split(",")[2] for r in rows[1:]], ["EUR", "EUR", "USD", "USD"])
+
+
+if __name__ == "__main__":
+    unittest.main()
