{
  "name": "graphene-vscode",
  "displayName": "Graphene",
  "description": "Your coding agent proposes a plan before it writes, and Graphene draws it as a graph. Each task runs in its own copy of your repository and lands only when its check passes.",
  "version": "0.10.0",
  "publisher": "alex-lop",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alex-lop/Graphene"
  },
  "homepage": "https://github.com/Alex-lop/Graphene/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/Alex-lop/Graphene/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "graphene",
    "coding agents",
    "claude code",
    "codex",
    "nemotron",
    "plan",
    "agents",
    "ai",
    "multi-agent",
    "parallel agents",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Graphene runs the graphene command, and the plan's checks, in this folder."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "graphene",
          "title": "Graphene",
          "icon": "media/graphene.svg"
        }
      ]
    },
    "views": {
      "graphene": [
        {
          "id": "graphene.home",
          "type": "webview",
          "name": "Home",
          "icon": "media/graphene.svg",
          "contextualTitle": "Graphene",
          "initialSize": 3
        },
        {
          "id": "graphene.needs",
          "name": "Needs You",
          "icon": "media/graphene.svg",
          "contextualTitle": "Graphene",
          "when": "config.graphene.advanced"
        },
        {
          "id": "graphene.agents",
          "name": "Agents",
          "icon": "media/graphene.svg",
          "contextualTitle": "Graphene",
          "when": "config.graphene.advanced"
        },
        {
          "id": "graphene.plan",
          "name": "Plan",
          "icon": "media/graphene.svg",
          "contextualTitle": "Graphene",
          "visibility": "collapsed",
          "when": "config.graphene.advanced"
        },
        {
          "id": "graphene.rounds",
          "name": "Rounds",
          "icon": "media/graphene.svg",
          "contextualTitle": "Graphene",
          "visibility": "collapsed",
          "when": "config.graphene.advanced"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "graphene.plan",
        "contents": "$(loading~spin) Reading the plan…",
        "when": "graphene.status == reading"
      },
      {
        "view": "graphene.plan",
        "contents": "Graphene is not installed, or not on this editor's PATH.\n\nIt looked on the PATH, in ~/.local/bin and in uv's tool bin.\n[Install Graphene](command:graphene.install)\nOr set the setting `graphene.path` to where it is.\n[Open Settings](command:workbench.action.openSettings?%22graphene.path%22)\n[Watch the Demo](command:graphene.watchDemo)",
        "when": "graphene.status == missing"
      },
      {
        "view": "graphene.needs",
        "contents": "Nothing waits for you.\n\nA question, a suggested task, a task that needs help or is to review, or auto mode waiting shows here, each with its move.",
        "when": "graphene.status == ok || graphene.status == empty"
      },
      {
        "view": "graphene.needs",
        "contents": "$(loading~spin) Reading the plan…",
        "when": "graphene.status == reading"
      },
      {
        "view": "graphene.needs",
        "contents": "Graphene is not installed, or not on this editor's PATH.\n[Install Graphene](command:graphene.install)\n[Watch the Demo](command:graphene.watchDemo)",
        "when": "graphene.status == missing"
      },
      {
        "view": "graphene.needs",
        "contents": "This folder has no plan yet.\n[Set Up This Folder](command:graphene.init)\n[Watch the Demo](command:graphene.watchDemo)",
        "when": "graphene.status == uninitialised"
      },
      {
        "view": "graphene.needs",
        "contents": "Graphene could not read the plan.\n\n[Try again](command:graphene.refresh)",
        "when": "graphene.status == error"
      },
      {
        "view": "graphene.needs",
        "contents": "Open a folder to see what needs you.",
        "when": "graphene.status == nofolder"
      },
      {
        "view": "graphene.agents",
        "contents": "No agent is running.\n\nEach running agent shows here: its number, task, model and attempt, what it is doing now, seconds quiet and dollars.",
        "when": "graphene.status == ok || graphene.status == empty"
      },
      {
        "view": "graphene.agents",
        "contents": "Running agents show here once the plan is read.",
        "when": "graphene.status != ok && graphene.status != empty"
      },
      {
        "view": "graphene.plan",
        "contents": "This folder has no plan yet.\n\nSet it up once with `graphene init`: it asks which planner and executor to use.\n[Set Up This Folder](command:graphene.init)\nThen ask your coding agent for a plan, in its chat.\n[Watch the Demo](command:graphene.watchDemo)",
        "when": "graphene.status == uninitialised"
      },
      {
        "view": "graphene.plan",
        "contents": "Graphene could not read the plan.\n\n[Try again](command:graphene.refresh)",
        "when": "graphene.status == error"
      },
      {
        "view": "graphene.plan",
        "contents": "Nothing is planned yet.\n\nAsk your coding agent for a plan, in its chat, or add a task.\n[Add Task…](command:graphene.addStep)",
        "when": "graphene.status == empty"
      },
      {
        "view": "graphene.plan",
        "contents": "Open a folder to see its plan.",
        "when": "graphene.status == nofolder"
      },
      {
        "view": "graphene.rounds",
        "contents": "No auto rounds here yet.\n\n`graphene auto`, in a terminal, plans a goal, races it, checks it and plans the fix; each round shows here, with what your envelope accepted, the attempt each task kept and why, and what landed."
      }
    ],
    "commands": [
      {
        "command": "graphene.home",
        "title": "Graphene: Home",
        "icon": "$(home)"
      },
      {
        "command": "graphene.showGraph",
        "title": "Graphene: Open the Graph",
        "icon": "$(screen-full)"
      },
      {
        "command": "graphene.openCockpit",
        "title": "Graphene: Open Cockpit",
        "icon": "$(terminal)"
      },
      {
        "command": "graphene.envelope",
        "title": "Graphene: Set Limits…"
      },
      {
        "command": "graphene.runReady",
        "title": "Graphene: Run Ready Tasks",
        "icon": "$(play)"
      },
      {
        "command": "graphene.stop",
        "title": "Graphene: Stop All Agents",
        "icon": "$(debug-stop)"
      },
      {
        "command": "graphene.accept",
        "title": "Graphene: Accept",
        "icon": "$(check)"
      },
      {
        "command": "graphene.acceptAll",
        "title": "Graphene: Accept All Suggestions",
        "icon": "$(check-all)"
      },
      {
        "command": "graphene.addStep",
        "title": "Graphene: Add Task…",
        "icon": "$(add)"
      },
      {
        "command": "graphene.link",
        "title": "Graphene: Make a Task Wait on Another…",
        "icon": "$(link)"
      },
      {
        "command": "graphene.editStep",
        "title": "Graphene: Edit Task…",
        "icon": "$(edit)"
      },
      {
        "command": "graphene.dropStep",
        "title": "Graphene: Remove Task",
        "icon": "$(trash)"
      },
      {
        "command": "graphene.tell",
        "title": "Graphene: Message Agent…",
        "icon": "$(comment)"
      },
      {
        "command": "graphene.init",
        "title": "Graphene: Set Up This Folder"
      },
      {
        "command": "graphene.refresh",
        "title": "Graphene: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "graphene.answer",
        "title": "Graphene: Answer…",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "graphene.handBack",
        "title": "Graphene: Help a Task…",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "graphene.install",
        "title": "Graphene: Install Graphene…",
        "icon": "$(cloud-download)"
      },
      {
        "command": "graphene.markDone",
        "title": "Graphene: Mark Your Task Done",
        "icon": "$(check)"
      },
      {
        "command": "graphene.setKey",
        "title": "Graphene: Set API Key…",
        "icon": "$(key)"
      },
      {
        "command": "graphene.openDiff",
        "title": "Graphene: Open Changes",
        "icon": "$(diff)"
      },
      {
        "command": "graphene.compareForks",
        "title": "Graphene: Compare Attempts",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "graphene.pickFork",
        "title": "Graphene: Keep This Attempt",
        "icon": "$(pass)"
      },
      {
        "command": "graphene.signOff",
        "title": "Graphene: Approve",
        "icon": "$(check)"
      },
      {
        "command": "graphene.editPlan",
        "title": "Graphene: Edit Plan as Text",
        "icon": "$(go-to-file)"
      },
      {
        "command": "graphene.addStepByHand",
        "title": "Graphene: Add Task by Hand…",
        "icon": "$(add)"
      },
      {
        "command": "graphene.watchDemo",
        "title": "Graphene: Watch the Demo",
        "icon": "$(play-circle)"
      },
      {
        "command": "graphene.diffWithAgent",
        "title": "Graphene: Compare with the Agent's Copy",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "graphene.openCockpit",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.envelope",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.runReady",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.accept",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.acceptAll",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.addStep",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.link",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.editStep",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.dropStep",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.tell",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.refresh",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.answer",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.handBack",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.markDone",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.openDiff",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.compareForks",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.pickFork",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.signOff",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.editPlan",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.addStepByHand",
          "when": "config.graphene.advanced"
        },
        {
          "command": "graphene.diffWithAgent",
          "when": "config.graphene.advanced"
        }
      ],
      "editor/title": [
        {
          "command": "graphene.pickFork",
          "when": "graphene.diff.fork",
          "group": "navigation@1"
        },
        {
          "command": "graphene.signOff",
          "when": "graphene.diff.review",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "graphene.showGraph",
          "when": "view == graphene.home",
          "group": "navigation@1"
        },
        {
          "command": "graphene.refresh",
          "when": "view == graphene.plan",
          "group": "navigation@5"
        },
        {
          "command": "graphene.showGraph",
          "when": "view == graphene.plan",
          "group": "navigation@1"
        },
        {
          "command": "graphene.runReady",
          "when": "view == graphene.plan",
          "group": "navigation@2"
        },
        {
          "command": "graphene.acceptAll",
          "when": "view == graphene.plan",
          "group": "navigation@3"
        },
        {
          "command": "graphene.addStep",
          "when": "view == graphene.plan",
          "group": "navigation@4"
        },
        {
          "command": "graphene.envelope",
          "when": "view == graphene.plan",
          "group": "1_run@1"
        },
        {
          "command": "graphene.openCockpit",
          "when": "view == graphene.plan",
          "group": "1_run@2"
        },
        {
          "command": "graphene.stop",
          "when": "view == graphene.plan",
          "group": "1_run@3"
        },
        {
          "command": "graphene.link",
          "when": "view == graphene.plan",
          "group": "2_plan@1"
        },
        {
          "command": "graphene.editPlan",
          "when": "view == graphene.plan",
          "group": "2_plan@2"
        },
        {
          "command": "graphene.addStepByHand",
          "when": "view == graphene.plan",
          "group": "2_plan@3"
        }
      ],
      "view/item/context": [
        {
          "command": "graphene.answer",
          "when": "view == graphene.needs && viewItem == need:question",
          "group": "inline@1"
        },
        {
          "command": "graphene.setKey",
          "when": "view == graphene.needs && viewItem == need:auto",
          "group": "inline@1"
        },
        {
          "command": "graphene.accept",
          "when": "view == graphene.needs && viewItem == need:proposal",
          "group": "inline@1"
        },
        {
          "command": "graphene.dropStep",
          "when": "view == graphene.needs && viewItem == need:proposal",
          "group": "inline@2"
        },
        {
          "command": "graphene.handBack",
          "when": "view == graphene.needs && viewItem =~ /^need:(hand-back|stopped)$/",
          "group": "inline@1"
        },
        {
          "command": "graphene.openDiff",
          "when": "view == graphene.needs && viewItem =~ /^need:(hand-back|sign-off)$/",
          "group": "inline@2"
        },
        {
          "command": "graphene.signOff",
          "when": "view == graphene.needs && viewItem == need:sign-off",
          "group": "inline@1"
        },
        {
          "command": "graphene.markDone",
          "when": "view == graphene.needs && viewItem == need:yours",
          "group": "inline@1"
        },
        {
          "command": "graphene.tell",
          "when": "view == graphene.needs && viewItem =~ /^need:(hand-back|stopped|sign-off)$/",
          "group": "1_act@1"
        },
        {
          "command": "graphene.showGraph",
          "when": "view == graphene.needs && viewItem =~ /^need:(proposal|hand-back|stopped|sign-off|yours)$/",
          "group": "1_act@2"
        },
        {
          "command": "graphene.openDiff",
          "when": "view == graphene.agents",
          "group": "inline@1"
        },
        {
          "command": "graphene.tell",
          "when": "view == graphene.agents",
          "group": "1_act@1"
        },
        {
          "command": "graphene.accept",
          "when": "view == graphene.plan && viewItem == task:proposed",
          "group": "inline@1"
        },
        {
          "command": "graphene.openDiff",
          "when": "view == graphene.plan && viewItem =~ /^task:(running|review|came-back|done)$/",
          "group": "1_act@0"
        },
        {
          "command": "graphene.compareForks",
          "when": "view == graphene.plan && viewItem =~ /^task:(running|review)$/",
          "group": "1_act@4"
        },
        {
          "command": "graphene.dropStep",
          "when": "view == graphene.needs && viewItem == need:hand-back",
          "group": "3_drop@1"
        },
        {
          "command": "graphene.accept",
          "when": "view == graphene.plan && viewItem == task:proposed",
          "group": "1_act@1"
        },
        {
          "command": "graphene.tell",
          "when": "view == graphene.plan && viewItem =~ /^task:(running|ready|waiting|came-back)$/",
          "group": "1_act@2"
        },
        {
          "command": "graphene.addStep",
          "when": "view == graphene.plan && viewItem =~ /^(task|goal)/",
          "group": "2_plan@1"
        },
        {
          "command": "graphene.link",
          "when": "view == graphene.plan && viewItem =~ /^task:/",
          "group": "2_plan@2"
        },
        {
          "command": "graphene.editStep",
          "when": "view == graphene.plan && viewItem =~ /^task:(proposed|ready|waiting|running|review|came-back|yours)$/",
          "group": "2_plan@3"
        },
        {
          "command": "graphene.dropStep",
          "when": "view == graphene.plan && viewItem =~ /^task:(proposed|ready|waiting|came-back)$/",
          "group": "3_drop@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get started with Graphene",
        "description": "Your coding agent proposes a plan before it writes, and Graphene draws it as a graph.",
        "steps": [
          {
            "id": "demo",
            "title": "Watch the demo",
            "description": "A recorded run plays in the graph: three agents race one task, and its check keeps one. No key and no network; it needs the graphene command, and offers to install it first.\n[Watch the Demo](command:graphene.watchDemo)",
            "media": {
              "image": "media/walk-demo.png",
              "altText": "the demo on the graph: one task raced by three attempts at once, a, b and c, beside three done and the goal they build"
            },
            "completionEvents": [
              "onCommand:graphene.watchDemo"
            ]
          },
          {
            "id": "install",
            "title": "Install Graphene",
            "description": "This extension drives the graphene command, 0.10 or later. Install it once with uv; the button runs uv tool install graphene-map for you, or uv tool upgrade graphene-map for an older one.\n[Install Graphene](command:graphene.install)",
            "media": {
              "image": "media/walk-install.png",
              "altText": "Home with no graphene command found: Graphene is not installed, and an Install Graphene button"
            },
            "completionEvents": [
              "onContext:graphene.status && graphene.status != missing && !graphene.older"
            ]
          },
          {
            "id": "setup",
            "title": "Set up a folder",
            "description": "On Graphene's Home, pick who plans and does the work: Claude Code or Codex. One click.\n[Open Home](command:graphene.home)",
            "media": {
              "image": "media/walk-setup.png",
              "altText": "Home's Set Up: approval on, then Claude Code or Codex, and what either choice writes"
            },
            "completionEvents": [
              "onContext:graphene.status == ok || graphene.status == empty"
            ]
          },
          {
            "id": "ask",
            "title": "Ask your agent for a plan",
            "description": "In Claude Code or Codex, say what you want, in its chat. It proposes a plan to Graphene: small tasks, each with the files it may change and the check that proves it. A workflow on Home, or Add task on the graph, makes one too. Read it on the graph, remove what you do not want, then Start.\n[Open the Graph](command:graphene.showGraph)",
            "media": {
              "image": "media/walk-ask.png",
              "altText": "a suggested plan on the graph, its four tasks with their files and checks, a question, and Start"
            },
            "completionEvents": [
              "onContext:graphene.status == ok"
            ]
          },
          {
            "id": "review",
            "title": "Review before it lands",
            "description": "Each finished task shows what changed and the check that passed. Open its changes, then Approve it, or Send it back with what is wrong. The graph shows the whole plan.\n[Open the Graph](command:graphene.showGraph)",
            "media": {
              "image": "media/walk-review.png",
              "altText": "Home's card for a task to review: what changed, the check that passed, Open changes, Approve and Send back"
            },
            "completionEvents": [
              "onCommand:graphene.showGraph"
            ]
          }
        ]
      }
    ],
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.graphene/worktrees/**": true
      },
      "search.exclude": {
        "**/.graphene/worktrees/**": true
      },
      "cursor.general.pinnedTitleActions": [
        "graphene.signOff",
        "graphene.pickFork"
      ]
    },
    "configuration": {
      "title": "Graphene",
      "properties": {
        "graphene.path": {
          "type": "string",
          "default": "graphene",
          "description": "The graphene command: a name on PATH or an absolute path. Unset, the extension looks on the PATH, in ~/.local/bin and in uv's tool bin. Only your own settings set it, never a folder's: a cloned repository cannot choose what the extension runs.",
          "scope": "machine"
        },
        "graphene.pollMs": {
          "type": "number",
          "default": 1500,
          "minimum": 250,
          "description": "How often, in milliseconds, the plan is read again while a Graphene view is open. File changes in the plan's store refresh it sooner."
        },
        "graphene.advanced": {
          "type": "boolean",
          "default": false,
          "description": "Show the advanced views (Needs You, Agents, Plan, Rounds) and every Graphene command in the Command Palette. Off, Home and the graph do it all."
        },
        "graphene.graph.openOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Open the graph as a tab by itself when you open Graphene's side bar, and when work starts: the window opens on a plan with work left, a plan appears, or a run starts. It does not take the keyboard focus and opens beside the file you are working in, never over it. A tab you close stays closed in that window until you ask for it with Open the graph, on Home or in the palette. Off, only that opens it."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit -p .",
    "test": "npm run check && node --experimental-strip-types --test \"test/*.test.ts\" && npm run build && node test/smoke.cjs",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/Alex-lop/Graphene/blob/main/editors/vscode --baseImagesUrl https://raw.githubusercontent.com/Alex-lop/Graphene/main/editors/vscode -o graphene-$npm_package_version.vsix",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "icon": "media/icon.png",
  "preview": true,
  "galleryBanner": {
    "color": "#14161a",
    "theme": "dark"
  }
