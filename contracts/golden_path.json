{
  "schema_version": 1,
  "product": "ReviewLatch",
  "repo_id": "reviewlatch-demo",
  "model": {
    "model_id": "gemini-3.5-flash",
    "adk_version": "2.5.0",
    "cloud_location": "global",
    "project_access_verified": false
  },
  "hashes": {
    "file": "sha256(raw file bytes)",
    "patch": "sha256(exact git diff --binary bytes)",
    "candidate_tree": "sha256(path UTF-8 + NUL + file bytes + NUL for sorted changed paths)",
    "test_receipt": "sha256(UTF-8 JSON with sort_keys=true, separators=(',', ':'), ensure_ascii=false, excluding receipt_sha256)",
    "idempotency_request": "sha256(UTF-8 JSON with sort_keys=true, separators=(',', ':'), ensure_ascii=false)"
  },
  "fixture": {
    "root": "demo/fixture",
    "tracked_paths": [
      "SECURITY.md",
      "app/__init__.py",
      "app/config.py",
      "app/auth/__init__.py",
      "app/auth/limiter.py",
      "docs/security.md",
      "tests/test_rate_limit.py"
    ],
    "mutable_paths": [
      "app/auth/limiter.py",
      "tests/test_security_policy.py"
    ],
    "fixed_test_command": ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"],
    "test_timeout_seconds": 15,
    "max_test_output_bytes": 16384,
    "max_write_bytes": 32768,
    "max_patch_bytes": 131072,
    "tree_sha256": "a5971830a5b7fac3f0fe7cac7904efa6061f036f713dbd68a59cc09b1152d222",
    "tree_hash_algorithm": "sha256(path + NUL + bytes + NUL for sorted tracked paths)"
  },
  "tool_names": ["read_file", "write_file", "run_fixture_tests"],
  "prompt": {
    "template": "You are the coding agent inside the controlled ReviewLatch demo fixture.\nUse only the provided read_file, write_file, and run_fixture_tests tools.\nRead the relevant files, make the smallest change that completes the task, and run the fixed tests.\nDo not add dependencies or edit files outside the tool's write allowlist.\n\nRepository memory:\n{memory_context}\n\nTask:\n{task}\n",
    "no_memory_context": "No approved memory applies.",
    "approved_memory_template": "[{memory_id} revision {revision}] {rule}"
  },
  "tasks": [
    {
      "task_id": "baseline_max_attempts",
      "instruction": "Change the authentication rate limit from 5 attempts to 4 attempts.",
      "repo_id": "reviewlatch-demo",
      "task_tags": ["authentication", "security", "rate-limiter"],
      "target_paths": ["app/auth/limiter.py"],
      "expected_changed_paths": ["app/auth/limiter.py"],
      "replacement_from": "MAX_ATTEMPTS = 5",
      "replacement_to": "MAX_ATTEMPTS = 4"
    },
    {
      "task_id": "adapted_window_seconds",
      "instruction": "Change the authentication rate-limit window from 60 seconds to 90 seconds.",
      "repo_id": "reviewlatch-demo",
      "task_tags": ["authentication", "security", "rate-limiter"],
      "target_paths": ["app/auth/limiter.py"],
      "expected_changed_paths": [
        "app/auth/limiter.py",
        "tests/test_security_policy.py"
      ],
      "replacement_from": "WINDOW_SECONDS = 60",
      "replacement_to": "WINDOW_SECONDS = 90"
    }
  ],
  "memory": {
    "memory_id": "mem_auth_review",
    "revision": 1,
    "correction": "When security-sensitive authentication behavior changes, add or update tests/test_security_policy.py with a regression test covering that behavior.",
    "clarification": "Should this apply to every app/auth/** change, or only rate-limiter changes?",
    "scope_options": [
      {
        "scope_id": "all_auth",
        "label": "Every app/auth/** change",
        "path_globs": ["app/auth/**"],
        "task_tags": ["authentication", "security"]
      },
      {
        "scope_id": "rate_limiter_only",
        "label": "Only rate-limiter changes",
        "path_globs": ["app/auth/limiter.py"],
        "task_tags": ["authentication", "security", "rate-limiter"]
      }
    ],
    "selected_scope_id": "all_auth",
    "rule": "Auth changes require a regression test in tests/test_security_policy.py covering the changed security behavior.",
    "repo_id": "reviewlatch-demo",
    "path_globs": ["app/auth/**"],
    "task_tags": ["authentication", "security"],
    "required_test_path": "tests/test_security_policy.py",
    "required_check": "new_test_fails_on_base_and_passes_on_candidate",
    "evidence_task_id": "baseline_max_attempts",
    "expected_security_assertion": "should_block(MAX_ATTEMPTS, 90) and not should_block(MAX_ATTEMPTS, 91)",
    "expected_security_test_content": "from app.auth.limiter import MAX_ATTEMPTS, should_block\n\n\ndef test_security_policy_uses_90_second_window():\n    assert should_block(MAX_ATTEMPTS, 90)\n    assert not should_block(MAX_ATTEMPTS, 91)\n"
  },
  "retrieval": {
    "states": ["approved"],
    "repo_match": "exact",
    "task_tag_match": "memory_tags_subset_of_task_tags",
    "path_match": "at_least_one_target_matches_glob"
  },
  "negative_retrieval_case": {
    "case_id": "docs_only_change",
    "repo_id": "reviewlatch-demo",
    "task_tags": ["documentation"],
    "target_paths": ["docs/security.md"],
    "expected_memory_ids": []
  },
  "api": [
    {"method": "GET", "path": "/healthz", "request_model": null, "response_model": "dict", "requires_demo_token": false},
    {"method": "POST", "path": "/api/demo/reset", "request_model": "DemoResetRequest", "response_model": "dict", "requires_demo_token": true},
    {"method": "GET", "path": "/api/runs", "request_model": null, "response_model": "list[RunRecord]", "requires_demo_token": false},
    {"method": "POST", "path": "/api/runs", "request_model": "CreateRunRequest", "response_model": "RunRecord", "requires_demo_token": true},
    {"method": "POST", "path": "/api/runs/{run_id}/execute", "request_model": "ExecuteRunRequest", "response_model": "RunRecord", "requires_demo_token": true},
    {"method": "GET", "path": "/api/runs/{run_id}", "request_model": null, "response_model": "RunRecord", "requires_demo_token": false},
    {"method": "POST", "path": "/api/runs/{run_id}/feedback", "request_model": "FeedbackRequest", "response_model": "MemoryRevision", "requires_demo_token": true},
    {"method": "POST", "path": "/api/memories/{memory_id}/decision", "request_model": "MemoryDecisionRequest", "response_model": "MemoryRevision", "requires_demo_token": true},
    {"method": "POST", "path": "/api/runs/{run_id}/promote", "request_model": "PromoteRunRequest", "response_model": "RunRecord", "requires_demo_token": true},
    {"method": "GET", "path": "/api/runs/{run_id}/proof", "request_model": null, "response_model": "list[ProofItem]", "requires_demo_token": false}
  ],
  "loop": [
    {"sequence": 1, "actor": "system", "action": "load dated real baseline evidence", "resulting_state": "baseline visible", "proof_type": null},
    {"sequence": 2, "actor": "human", "action": "anchor exact correction and choose all_auth scope", "resulting_state": "scope selected", "proof_type": null},
    {"sequence": 3, "actor": "system", "action": "create exact deterministic memory proposal", "resulting_state": "memory proposed", "proof_type": "memory.proposed"},
    {"sequence": 4, "actor": "human", "action": "approve immutable memory revision 1", "resulting_state": "memory approved", "proof_type": "memory.approved"},
    {"sequence": 5, "actor": "system", "action": "create fresh adapted run with new session ID", "resulting_state": "queued", "proof_type": null},
    {"sequence": 6, "actor": "system", "action": "retrieve and inject exact approved memory revision", "resulting_state": "running", "proof_type": "memory.injected"},
    {"sequence": 7, "actor": "gemini", "action": "write only allowlisted candidate files", "resulting_state": "running", "proof_type": "tool.file_written"},
    {"sequence": 8, "actor": "system", "action": "prove the new test fails on base and all tests pass on candidate", "resulting_state": "running", "proof_type": "test.completed"},
    {"sequence": 9, "actor": "system", "action": "persist immutable candidate and attempt completion", "resulting_state": "waiting_for_promotion", "proof_type": "completion.denied"},
    {"sequence": 10, "actor": "human", "action": "approve exact bound candidate", "resulting_state": "promoting", "proof_type": "promotion.approved"},
    {"sequence": 11, "actor": "system", "action": "reconstruct, revalidate, and commit in ephemeral fixture", "resulting_state": "promoting", "proof_type": "candidate.committed"},
    {"sequence": 12, "actor": "system", "action": "persist promotion receipt before completion", "resulting_state": "completed", "proof_type": null}
  ]
}
