    "platform-maintainer@1",
    "auth-maintainer@1",
    "billing-observer@1"
  ],
  "run_states": [
    "STARTING",
    "LIVE",
    "WAITING_INPUT",
    "ACCESS_DENIED",
    "NEEDS_HUMAN",
    "FAILED",
    "INTERRUPTED",
    "PROMOTED",
    "REJECTED",
    "EVIDENCE_INVALID"
  ],
  "event_types": [
    "run.started",
    "invocation.started",
    "invocation.completed",
    "invocation.failed",
    "run.interrupted",
    "run.failed",
    "run.ended",
    "tool.started",
    "tool.completed",
    "tool.failed",
    "clarification.asked",
    "clarification.answered",
    "completion.attempted",
    "candidate.created",
    "candidate.rejected",
    "changeset.parsed",
    "test.receipt.created",
    "feedback.recorded",
    "memory.proposed",
    "memory.approved",
    "memory.rejected",
    "promotion.approved",
    "context.compiled",
    "context.injected",
    "handoff.denied",
    "scope.allowed",
    "scope.denied",
    "completion.denied",
    "promotion.denied",
    "promotion.completed",
    "local_result.recorded"
  ],
  "operations": [
    "search_repo",
    "read_file",
    "open_evidence",
    "write_file",
    "run_fixed_test",
    "request_completion"
  ],
  "store_interface": [
    "append",
    "tail",
    "verify"
  ],
  "cli": [
    "run",
    "watch",
    "inspect",
    "why",
    "replay",
    "feedback",
    "answer",
    "memory approve",
    "memory reject",
    "handoff",
    "promote",
    "demo"
  ],
  "mcp_tools": {
    "search_repo": ["query"],
    "read_file": ["path"],
    "open_evidence": ["evidence_id"],
    "write_file": ["path", "content"],
    "run_fixed_test": [],
    "request_completion": []
  },
  "truth_kinds": [
    "runtime_observed",
    "server_derived",
