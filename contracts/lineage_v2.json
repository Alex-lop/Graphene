    "context_brief",
    "injection_receipt",
    "promotion_receipt",
    "evidence_blob",
    "policy_receipt",
    "operator_request",
    "simulated_fixture",
    "adk_event_receipt",
    "mcp_request_receipt",
    "local_adapter_receipt",
    "local_commit_receipt"
