.gcloudignore
# Cloud Build receives only the Python package inputs needed by read-only Mission Control.
**
!.gcloudignore
!README.md
!pyproject.toml
!uv.lock
!backend/
!backend/**/
!backend/**/*.py
!backend/graphene/orchestration/static/mission-replay.json
!backend/graphene/orchestration/static/mission-replay.sha256
!backend/graphene/orchestration/static/mission_control.css
!backend/graphene/orchestration/static/mission_control.html
!backend/graphene/orchestration/static/mission_control.mjs
!backend/graphene/orchestration/static/mission_reducer.mjs
!backend/graphene/viewer/static/vendor/CYTOSCAPE_LICENSE.txt
!backend/graphene/viewer/static/vendor/README.txt
!backend/graphene/viewer/static/vendor/cytoscape.esm.min.mjs
!demo/
!demo/taskmaster/
!demo/taskmaster/**/
!demo/taskmaster/**/*.py
!demo/taskmaster/scenario.json
!deploy/
!deploy/cloudrun/
!deploy/cloudrun/Dockerfile
!deploy/cloudrun/cloudbuild.yaml
!deploy/cloudrun/coordinator.Dockerfile
!deploy/cloudrun/coordinator-cloudbuild.yaml

# The Cloud Run images COPY these, and pyproject.toml's
# [tool.hatch.build.targets.wheel.force-include] requires them at wheel-build
# time. Without them in the uploaded context Cloud Build cannot build either image.
!contracts/
!contracts/golden_path.json
!contracts/graph_mvp.json
!demo/fixture/
!demo/fixture/**
!demo/north_star/
!demo/north_star/**
!scripts/
!scripts/materialize_north_star.py
