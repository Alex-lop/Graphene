.DS_Store
.env
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]
frontend/dist/
frontend/node_modules/
demo/runs/
dist/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Local planning, prompts, and reviews
All_md_files/

# Local cycle diaries and proof ledger
evidence/checkpoints/*-cycle-*.md
evidence/claim_ledger.json

# Local-only raw session transcripts and private captures (never committed)
local/

# Editor and agent-harness state
.claude/
.vscode/

# Session authority directives: they live in the gitignored local/ tree and
# are never committed. A copy dropped at the repo root must not sneak in.
/GRAPHENE_*DIRECTIVE*.md

# Private mission exports written into the working tree by `graphene bundle
# create` / `mission result export`. They carry real mission digests and are
# a user artifact, not repository content.
/bundle.json

# Stray images dropped at the repo root are working material, not repository
# content; committed assets live under docs/assets/.
/*.png
/*.jpg

# Reliability-lane run logs: evidence, not source.
.nightwatch/
