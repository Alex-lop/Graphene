# Current v2 demos do not need provider or cloud credentials.
# `verified-replay` is cross-platform and creates no authoritative lineage state.
# `scripted-local` and `adk-fake` own private runtimes and require the supported
# macOS `/usr/bin/sandbox-exec` fixed-test boundary.
GRAPHENE_LINEAGE_DB=

# Compatibility-only legacy HTTP container settings (`backend/graphene/app.py`).
# They do not enable authoritative v2 fixed tests on Linux/Docker.
GRAPHENE_ENTRYPOINT_MODE=legacy-http-compatibility
GRAPHENE_EXECUTION_MODE=deterministic-local
GRAPHENE_MODEL=graphene-compatibility-fixture
GRAPHENE_STORE_BACKEND=memory
GRAPHENE_STORE_PATH=
GRAPHENE_NAMESPACE=hackathon
GRAPHENE_DEMO_TOKEN=
PORT=8080

# Future external-live work is not shipped and has no default credential path.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=
