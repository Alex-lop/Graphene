GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
CLOUD_RUN_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GRAPHENE_MODEL=gemini-3.5-flash
GRAPHENE_EXECUTION_MODE=deterministic-local
GRAPHENE_STORE_BACKEND=memory
GRAPHENE_STORE_PATH=
GRAPHENE_NAMESPACE=hackathon
GRAPHENE_DEMO_TOKEN=
# The primary `graphene demo --driver scripted-local` owns a private SQLite path
# and needs none of the provider, database, or legacy demo variables above.
PORT=8080
