# Taskmaster local state. If set, this must be an absolute private path with no
# symlink components. The default is ~/.graphene/state.
GRAPHENE_STATE_DIR=

# Live Gemini planning is opt-in and never falls back. Use exactly one API key,
# or set Vertex AI mode plus project/location and valid ADC. Do not commit values.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GRAPHENE_RUN_LIVE_GEMINI=
GRAPHENE_RUN_DOCKER_SMOKE=

# fixture-tests checks on the gemini-adk path: "docker" (default, needs a
# responsive daemon + built executor image) or "host-sandbox" (macOS
# /usr/bin/sandbox-exec, no Docker required). Any other value fails closed.
GRAPHENE_CHECK_EXECUTOR=

# Firestore viewer/coordinator names. Set only for an explicit emulator or cloud
# gate. Packaging is checked in; no deployment is claimed.
GRAPHENE_FIRESTORE_DATABASE=
GRAPHENE_FIRESTORE_NAMESPACE=
GRAPHENE_MISSION_ID=
GRAPHENE_MISSION_CONTROL_READ_TOKEN=
GRAPHENE_COORDINATOR_URL=
GRAPHENE_COORDINATOR_AUDIENCE=
GRAPHENE_COORDINATOR_EXECUTOR_BINDINGS=
GRAPHENE_RUN_FIRESTORE_EMULATOR=
FIRESTORE_EMULATOR_HOST=
GRAPHENE_RUN_LIVE_FIRESTORE=
GRAPHENE_RUN_CLOUD_SMOKE=
GRAPHENE_LIVE_FIRESTORE_PROJECT=
GRAPHENE_LIVE_FIRESTORE_DATABASE=
GRAPHENE_LIVE_FIRESTORE_NAMESPACE=

# Legacy Auth protocol-tour commands use an existing absolute owner-private DB.
GRAPHENE_LINEAGE_DB=

# Compatibility-only legacy HTTP container settings (backend/graphene/legacy_app.py).
# These do not enable Taskmaster, authoritative v2 fixed tests, Gemini, or cloud.
GRAPHENE_ENTRYPOINT_MODE=
GRAPHENE_EXECUTION_MODE=
GRAPHENE_MODEL=
GRAPHENE_STORE_BACKEND=
GRAPHENE_STORE_PATH=
GRAPHENE_NAMESPACE=
GRAPHENE_DEMO_TOKEN=
PORT=
