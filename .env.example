# Taskmaster local state. If set, this must be an absolute private path with no
# symlink components. The default is ~/.graphene/state.
GRAPHENE_STATE_DIR=

# Live Gemini planning is opt-in and never falls back. Use exactly one API key,
# or set Vertex AI mode plus project/location and valid ADC. Do not commit values.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Cloud Run's read-only Firestore Mission Control requires every value explicitly.
# Packaging is checked in; no deployment is claimed.
GRAPHENE_FIRESTORE_DATABASE=
GRAPHENE_FIRESTORE_NAMESPACE=
GRAPHENE_MISSION_ID=
GRAPHENE_MISSION_CONTROL_READ_TOKEN=

# Legacy Auth protocol-tour commands use an existing absolute owner-private DB.
GRAPHENE_LINEAGE_DB=

# Compatibility-only legacy HTTP container settings (backend/graphene/app.py).
# These do not enable Taskmaster, authoritative v2 fixed tests, Gemini, or cloud.
GRAPHENE_ENTRYPOINT_MODE=legacy-http-compatibility
GRAPHENE_EXECUTION_MODE=deterministic-local
GRAPHENE_MODEL=graphene-compatibility-fixture
GRAPHENE_STORE_BACKEND=memory
GRAPHENE_STORE_PATH=
GRAPHENE_NAMESPACE=hackathon
GRAPHENE_DEMO_TOKEN=
PORT=8080
